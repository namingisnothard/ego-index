{
  "name": "sites-project",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "prebuild": "npm run audit:maintenance:strict",
    "build": "vinext build",
    "build:pages": "GITHUB_PAGES=true next build",
    "start": "vinext start",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "refresh:impact": "node scripts/refresh-impact.mjs",
    "refresh:impact:resume": "node scripts/refresh-impact.mjs --resume --crossref-only",
    "refresh:impact:crossref": "node scripts/refresh-impact.mjs --crossref-only",
    "refresh:impact:linked": "node scripts/refresh-impact.mjs --linked-only --resume",
    "refresh:impact:new": "node scripts/refresh-impact.mjs --linked-only --new-only",
    "refresh:impact:components": "node scripts/refresh-impact.mjs --linked-only --retry-components",
    "refresh:institutions": "node scripts/refresh-impact.mjs --institutions-only",
    "refresh:snapshots": "node scripts/refresh-snapshots.mjs",
    "materialize:snapshots": "node scripts/materialize-snapshots.mjs",
    "refresh:impact:validate": "node scripts/refresh-impact.mjs --validate-only",
    "audit:maintenance": "node scripts/audit-maintenance.mjs",
    "audit:maintenance:strict": "node scripts/audit-maintenance.mjs --strict"
  },
  "dependencies": {
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@openai/sites-vite-plugin": "^0.1.0 || ^0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.3",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
